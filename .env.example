# Google Sheets 연결 설정 (서버 전용 — NEXT_PUBLIC_ 접두사를 붙이지 마세요)
# 세 값이 모두 있으면 Google Sheets를, 하나라도 없으면 개발용 예시 데이터를 사용합니다.

# 스프레드시트 URL https://docs.google.com/spreadsheets/d/<이 부분>/edit 의 ID
GOOGLE_SHEETS_SPREADSHEET_ID=

# 서비스 계정 이메일 (예: dashboard@my-project.iam.gserviceaccount.com)
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# 서비스 계정 JSON 키의 private_key 값. 줄바꿈은 \n 으로 적고 큰따옴표로 감싸 주세요.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# WBS 동기화: 회사 계정으로 배포한 Apps Script 웹 앱(apps-script/wbs-proxy.gs) 주소와 비밀 키
# 키는 아무 긴 임의 문자열. 스크립트 속성 KEY에도 같은 값을 넣는다.
WBS_SCRIPT_URL=
WBS_SCRIPT_KEY=
